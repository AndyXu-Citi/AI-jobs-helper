# ============================================
# AI Collector Project - Environment Variables
# ============================================
# 复制此文件为 .env 并填入你的真实凭证
# cp .env.example .env

# ----- RSSHub 配置 (可选, 当前版本已弃用) -----
RSSHUB_URL=http://localhost:1201

# ----- LLM 配置 (任意 OpenAI 兼容端点，默认填 DeepSeek) -----
# 本项目用标准 OpenAI 兼容客户端，火山/DeepSeek/通义等任意兼容端点都可，仅改下面三行
# LLM_API_KEY 在对应平台控制台创建（示例：https://platform.deepseek.com）
LLM_API_KEY=your_deepseek_api_key_here

# DeepSeek OpenAI 兼容接口地址（注意带 /v1）
LLM_API_BASE=https://api.deepseek.com/v1

# DeepSeek 模型名：deepseek-chat (V3, 推荐) 或 deepseek-reasoner (R1)
LLM_MODEL=deepseek-chat

# ----- MySQL 数据库（替代 SQLite）-----
# 迁移前先手动在 MySQL 中建好库：CREATE DATABASE ai_collector DEFAULT CHARACTER SET utf8mb4;
# 表结构会在首次启动时自动创建（DBManager._ensure_tables）。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=ai_collector

# ----- Bilibili 反爬 (可选, v1.1 新增) -----
# 当 monitor.py 的 requests 直接请求 B 站 API 命中 412/-799/-412 等错误码时，
# 系统会自动 fallback 到 Playwright。如果你能提供登录态 cookie，requests 路径
# 也能更稳定地拿到数据：
#   1. 浏览器登录 bilibili.com
#   2. F12 -> Network -> 任意 api.bilibili.com 请求 -> Request Headers -> Cookie
#   3. 整段复制粘贴到下面（保留双引号）
# 不填也能跑，会走 Playwright fallback。
# BILI_COOKIE="buvid3=xxx; SESSDATA=xxx; bili_jct=xxx; ..."
